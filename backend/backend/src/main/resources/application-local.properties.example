# Copy this file to application-local.properties and fill in local values.
# Activate the "local" Spring profile when running the backend.

spring.datasource.username=root
spring.datasource.password=your-database-password

spring.mail.username=your-sender@gmail.com
spring.mail.password=your-google-app-password

app.admin.email=admin@example.com
app.admin.username=adminuser
app.admin.password=replace-with-a-strong-password

# Use the same Google OAuth Web Client ID as frontend/.env.local.
app.google.client-id=your-google-oauth-web-client-id

# Required by the local profile's JWT configuration.
app.jwt.secret=replace-with-a-strong-random-secret
