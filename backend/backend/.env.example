# Google OAuth Web client ID; use the same ID in frontend/.env.local.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# Gmail SMTP sender account and its 16-character Google App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-google-app-password

# Public URL used to build email verification links.
APP_BACKEND_URL=http://localhost:8080

# Database connection (defaults to local MySQL database road_ticket).
DB_URL=jdbc:mysql://localhost:3306/road_ticket?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-database-password

# JWT signing configuration.
JWT_SECRET=replace-with-a-strong-random-secret

# Optional: seed the initial admin account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=adminuser
# ADMIN_PASSWORD=replace-with-a-strong-password
